# --- Login credentials for the webapp (required) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-please

# Secret used to sign the session cookie. Set this to a long random string.
# You can generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string

# Public URL of the app as users open it in the browser (no trailing slash).
# Required for YouTube OAuth on a VPS / domain, e.g. https://vod.example.com
PUBLIC_URL=http://localhost:3000

# Port the server listens on inside the container.
PORT=3000

# How many total attempts (yt-dlp process restarts) before a job is marked failed.
MAX_DOWNLOAD_ATTEMPTS=8

# Cap for ./downloads (and the in-app storage bar). New downloads are blocked when full.
STORAGE_LIMIT_GB=30

# --- YouTube upload (optional) ---
# Create an OAuth client in Google Cloud with the YouTube Data API v3 enabled.
# Add this exact callback as an Authorized redirect URI on the OAuth client:
#   ${PUBLIC_URL}/api/youtube/oauth/callback
# Then use Settings → Authorize YouTube and paste the refresh token here.
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional full override (defaults to ${PUBLIC_URL}/api/youtube/oauth/callback):
# YOUTUBE_REDIRECT_URI=https://vod.example.com/api/youtube/oauth/callback
# Fallback privacy for auto-upload if the popup has never been used. Per-video privacy is set in the upload popup (default unlisted).
YOUTUBE_PRIVACY=unlisted
